# Copy this file to .env and fill in your values.

# "ollama" (local, free) or "openai"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Local Docker (docker compose up -d) uses these credentials.
# For a hosted Postgres such as Neon or Supabase, paste its connection string instead.
DATABASE_URL=postgresql://optik:optik@localhost:5433/optik

# Model overrides. When unset, defaults depend on LLM_PROVIDER:
#   ollama: gemma3:4b + bge-m3 (1024 dims)
#   openai: gpt-5-mini + text-embedding-3-small (1536 dims)
# Changing the embedding model changes EMBEDDING_DIM: re-ingest with `python -m app.ingest --reset`.
# CHAT_MODEL=qwen2.5:7b
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024
# REASONING_EFFORT=low        (OpenAI GPT-5 models only)

# Retrieval settings (defaults shown)
# CHUNK_SIZE=200
# CHUNK_OVERLAP=40
# TOP_K=5
# MIN_SIMILARITY=0.0
